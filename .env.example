# URL definitiva do site (usada em canonical, Open Graph, sitemap e robots).
# Em produção, defina o domínio real da Vercel.
NEXT_PUBLIC_SITE_URL=https://floriografia.vercel.app

# E-mail público de contato/efeito.
# Com esta variável preenchida, os formulários de /contato e /correcoes
# abrem o aplicativo de e-mail do usuário com a mensagem pronta (mailto:).
# Sem ela, o formulário valida os campos e avisa que nada foi enviado.
# NEXT_PUBLIC_CONTACT_EMAIL=contato@seudominio.com.br

# Chave da API do Pexels (https://www.pexels.com/api/) - so no .env.local
PEXELS_API_KEY=
